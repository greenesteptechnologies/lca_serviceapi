{
  "name": "lca_serviceapi",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rimraf deploy",
    "copy-files": "copyfiles package.json package-lock.json web.config swagger.yaml deploy",
    "copy-env": "if exist .env (copy /Y .env deploy\\.env) else (echo .env file not found, skipping)",
    "copy-public": "copyfiles -u 1 public/**/* deploy",
    "copy-templates": "copyfiles -u 2 src/templates/**/*.ejs deploy/dist/templates",
    "build-production": "npm run clean && npm run build && mkdir deploy && xcopy dist deploy\\dist /E /I /Y && if exist deploy\\dist\\.env del /Q deploy\\dist\\.env && npm run copy-templates && npm run copy-files && npm run copy-env && npm run copy-public"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "morgan": "^1.10.1",
    "mssql": "^12.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^4.9.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^9.1.11",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "@types/yamljs": "^0.2.34",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
