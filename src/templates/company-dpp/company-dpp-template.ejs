<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= company.name %> — Company DPP</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --teal: #1a6b6b;
      --teal-light: #e6f4f4;
      --teal-mid: #2e9e9e;
      --green: #2d8a4e;
      --green-light: #e8f5ec;
      --slate: #4a5568;
      --slate-light: #f7f8fa;
      --border: #e2e8f0;
      --text-primary: #1a202c;
      --text-secondary: #64748b;
      --white: #ffffff;
      --shadow: 0 2px 12px rgba(0,0,0,0.07);
      --radius: 12px;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f0f4f7;
      color: var(--text-primary);
      min-height: 100vh;
      padding-bottom: 80px;
    }

    /* ── Header Banner ── */
    .hero {
      background: linear-gradient(135deg, #2c4a6e 0%, #1a6b6b 60%, #2e9e9e 100%);
      padding: 2rem 1.5rem 2.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -40px; right: -40px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
    }

    .hero-inner {
      max-width: 600px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .hero-text .brand {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.1em;
      color: rgba(255,255,255,0.6);
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .hero-text h1 {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.02em;
      margin-bottom: 8px;
    }

    .hero-text p {
      font-size: 12.5px;
      color: rgba(255,255,255,0.75);
      line-height: 1.6;
      max-width: 340px;
    }

    .hero-meta {
      display: flex;
      gap: 6px;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .hero-tag {
      background: rgba(255,255,255,0.15);
      color: rgba(255,255,255,0.9);
      font-size: 11px;
      font-weight: 500;
      padding: 3px 10px;
      border-radius: 20px;
      backdrop-filter: blur(4px);
    }

    .hero-logo-wrap {
      width: 80px;
      height: 80px;
      background: rgba(255,255,255,0.12);
      border-radius: 16px;
      border: 1.5px solid rgba(255,255,255,0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      backdrop-filter: blur(8px);
      overflow: hidden;
    }

    .hero-logo-wrap i {
      font-size: 36px;
      color: rgba(255,255,255,0.85);
    }

    .hero-logo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ── Page wrapper ── */
    .page {
      max-width: 600px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    /* ── Tab pill ── */
    .tab-pill-wrap {
      display: flex;
      justify-content: center;
      margin-top: -18px;
      margin-bottom: 1.25rem;
      position: relative;
      z-index: 2;
    }

    .tab-pills {
      display: flex;
      background: #fff;
      border-radius: 30px;
      padding: 4px;
      box-shadow: var(--shadow);
      gap: 2px;
    }

    .tab-pill {
      padding: 7px 18px;
      border-radius: 24px;
      font-size: 12.5px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-family: inherit;
      transition: all 0.18s;
    }

    .tab-pill.active {
      background: var(--teal);
      color: #fff;
    }

    /* ── Section card ── */
    .card {
      background: #fff;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 14px 16px 10px;
      border-bottom: 1px solid var(--border);
    }

    .card-header i {
      font-size: 16px;
      color: var(--teal);
    }

    .card-header h2 {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .card-body {
      padding: 14px 16px;
    }

    /* ── Company info grid ── */
    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .info-item .label {
      font-size: 10.5px;
      color: var(--text-secondary);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 3px;
    }

    .info-item .value {
      font-size: 13.5px;
      color: var(--text-primary);
      font-weight: 500;
    }

    .info-item .value a {
      color: var(--teal-mid);
      text-decoration: none;
    }

    /* ── Emissions metric cards ── */
    .metric-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      padding: 14px 16px;
    }

    .metric-card {
      background: var(--slate-light);
      border-radius: 10px;
      padding: 14px 10px;
      text-align: center;
      border: 1px solid var(--border);
      position: relative;
    }

    .metric-card .m-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 10px;
    }

    .metric-card .m-icon i {
      font-size: 18px;
    }

    .metric-card .m-value {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.1;
    }

    .metric-card .m-unit {
      font-size: 10.5px;
      color: var(--text-secondary);
      margin-top: 3px;
      line-height: 1.3;
    }

    .metric-card .m-plus {
      position: absolute;
      bottom: 6px;
      right: 8px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      color: var(--text-secondary);
      cursor: pointer;
      font-weight: 600;
    }

    /* ── Scope badges ── */
    .scope-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      padding: 0 16px 14px;
    }

    .scope-card {
      border-radius: 9px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .scope-card .sc-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 4px;
    }

    .scope-card .sc-val {
      font-size: 15px;
      font-weight: 700;
    }

    .scope-card .sc-sub {
      font-size: 10px;
      color: var(--text-secondary);
      margin-top: 1px;
    }

    .sc-1 { background: #fff8e6; border-color: #f5d78a; }
    .sc-1 .sc-label { color: #946c00; }
    .sc-1 .sc-val { color: #7a5500; }

    .sc-2 { background: #e8f5ec; border-color: #9dd4ae; }
    .sc-2 .sc-label { color: #1b6b35; }
    .sc-2 .sc-val { color: #1b6b35; }

    .sc-3 { background: #eef2ff; border-color: #a5b4fc; }
    .sc-3 .sc-label { color: #3730a3; }
    .sc-3 .sc-val { color: #3730a3; }

    /* ── Toggle ── */
    .toggle-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 10px 0 4px;
      font-size: 12.5px;
      color: var(--text-secondary);
    }

    .tgl {
      width: 36px;
      height: 20px;
      border-radius: 10px;
      background: var(--teal-mid);
      border: none;
      cursor: pointer;
      position: relative;
    }

    .tgl::after {
      content: '';
      position: absolute;
      right: 3px;
      top: 3px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #fff;
    }

    /* ── KPI lists ── */
    .kpi-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .kpi-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 16px;
      border-bottom: 1px solid var(--border);
    }

    .kpi-item:last-child { border-bottom: none; }

    .kpi-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .kpi-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .kpi-icon i { font-size: 17px; }

    .kpi-name {
      font-size: 13px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .kpi-desc {
      font-size: 11px;
      color: var(--text-secondary);
      margin-top: 1px;
    }

    .kpi-right {
      text-align: right;
    }

    .kpi-val {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .kpi-unit {
      font-size: 10.5px;
      color: var(--text-secondary);
    }

    /* ── Green practices ── */
    .practices-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 14px 16px;
    }

    .practice-card {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
      background: var(--slate-light);
    }

    .practice-img {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      position: relative;
    }

    .practice-img .img-label {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(transparent, rgba(0,0,0,0.55));
      color: #fff;
      font-size: 11px;
      font-weight: 600;
      padding: 6px 8px 4px;
    }

    .practice-body {
      padding: 8px 10px 10px;
    }

    .practice-body p {
      font-size: 11.5px;
      color: var(--text-secondary);
      line-height: 1.5;
    }

    /* ── Certificates ── */
    .cert-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .cert-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      border-bottom: 1px solid var(--border);
    }

    .cert-item:last-child { border-bottom: none; }

    .cert-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .cert-icon {
      width: 32px; height: 32px;
      background: var(--teal-light);
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
    }

    .cert-icon i { font-size: 16px; color: var(--teal); }

    .cert-name { font-size: 13px; font-weight: 500; color: var(--text-primary); }
    .cert-issuer { font-size: 11px; color: var(--text-secondary); margin-top: 1px; }

    .cert-badge {
      font-size: 10.5px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 12px;
    }

    .cert-badge.active { background: var(--green-light); color: var(--green); }
    .cert-badge.pending { background: #fff8e1; color: #92681a; }

    /* ── Location & contact ── */
    .loc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 14px 16px;
    }

    .loc-block .loc-label {
      font-size: 10.5px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .loc-block p {
      font-size: 12.5px;
      color: var(--text-primary);
      line-height: 1.55;
    }

    .loc-block a {
      color: var(--teal-mid);
      text-decoration: none;
      font-size: 12.5px;
    }

    /* ── LCA Config strip ── */
    .lca-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border-top: 1px solid var(--border);
    }

    .lca-item {
      padding: 12px 14px;
      border-right: 1px solid var(--border);
      text-align: center;
    }

    .lca-item:last-child { border-right: none; }

    .lca-item .ll { font-size: 10px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: 3px; }
    .lca-item .lv { font-size: 13px; font-weight: 600; color: var(--text-primary); }

    /* ── About section ── */
    .about-block {
      padding: 14px 16px;
    }

    .about-block h3 {
      font-size: 11px;
      font-weight: 700;
      color: var(--teal);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 6px;
    }

    .about-block p {
      font-size: 12.5px;
      color: var(--text-secondary);
      line-height: 1.65;
    }

    .about-divider {
      height: 1px;
      background: var(--border);
      margin: 12px 0;
    }

    /* ── Tab panels ── */
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ── Powered by ── */
    .powered {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 11.5px;
      color: var(--text-secondary);
    }

    .powered span {
      font-weight: 600;
      color: var(--teal);
    }

    /* ── Bottom nav ── */
    .bottom-nav {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #fff;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: center;
      gap: 6px;
      padding: 10px 1rem;
      z-index: 10;
      box-shadow: 0 -2px 12px rgba(0,0,0,0.06);
    }

    .nav-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px 14px;
      border-radius: 10px;
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 10px;
      transition: all 0.15s;
    }

    .nav-btn i { font-size: 20px; }

    .nav-btn.active {
      background: var(--teal);
      color: #fff;
    }

    /* ── Chart bar ── */
    .bar-chart {
      padding: 10px 16px 14px;
    }

    .bar-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 8px;
    }

    .bar-label {
      font-size: 11px;
      color: var(--text-secondary);
      width: 80px;
      flex-shrink: 0;
      text-align: right;
    }

    .bar-track {
      flex: 1;
      height: 10px;
      background: var(--slate-light);
      border-radius: 5px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: 5px;
      transition: width 0.8s ease;
    }

    .bar-val {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-primary);
      width: 55px;
      flex-shrink: 0;
    }

    /* ── Verified badge ── */
    .verified-row {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--green-light);
      border-top: 1px solid #c3e6cb;
    }

    .verified-row i { font-size: 14px; color: var(--green); }
    .verified-row span { font-size: 11.5px; color: var(--green); font-weight: 500; }

    /* ── Privacy link ── */
    .privacy-link {
      text-align: center;
      padding: 8px;
      font-size: 11.5px;
    }

    .privacy-link a { color: var(--teal-mid); text-decoration: none; }
  </style>
</head>
<body>

  <!-- Hero Banner -->
  <div class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="brand"><%= company.brand %></div>
        <h1><%= company.displayName %></h1>
        <p><%= company.tagline %></p>
        <div class="hero-meta">
          <% company.tags.forEach(function(tag) { %>
            <span class="hero-tag"><%= tag %></span>
          <% }); %>
        </div>
      </div>
      <div class="hero-logo-wrap">
        <% if (company.logoUrl) { %>
          <img src="<%= company.logoUrl %>" alt="<%= company.name %> logo" />
        <% } else { %>
          <i class="ti <%= company.logoIcon || 'ti-building-factory-2' %>"></i>
        <% } %>
      </div>
    </div>
  </div>

  <div class="page">

    <!-- Tab Pills -->
    <div class="tab-pill-wrap">
      <div class="tab-pills">
        <button class="tab-pill active" onclick="switchTab('footprint', this)">Carbon Footprint</button>
        <button class="tab-pill" onclick="switchTab('profile', this)">Company Profile</button>
        <button class="tab-pill" onclick="switchTab('practices', this)">Sustainability</button>
      </div>
    </div>

    <!-- ══ TAB: Carbon Footprint ══ -->
    <div class="tab-panel active" id="tab-footprint">

      <!-- Toggle -->
      <div class="toggle-header">
        <span>Scientific</span>
        <button class="tgl" aria-label="Toggle view"></button>
        <span>Equivalences</span>
      </div>

      <!-- Main Emission Metrics -->
      <div class="card" style="margin-top:10px">
        <div class="card-header">
          <i class="ti ti-cloud"></i>
          <h2>Total Emissions — <%= emissions.reportingYear %></h2>
        </div>
        <div class="metric-row">
          <div class="metric-card">
            <div class="m-icon"><i class="ti ti-flame" style="color:#e57c2e"></i></div>
            <div class="m-value"><%= emissions.total.toFixed(2) %></div>
            <div class="m-unit">tCO₂e<br>Total Emissions</div>
            <div class="m-plus">+</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><i class="ti ti-bolt" style="color:#2e9e9e"></i></div>
            <div class="m-value"><%= emissions.energy.toFixed(2) %></div>
            <div class="m-unit">tCO₂e<br>Energy</div>
            <div class="m-plus">+</div>
          </div>
          <div class="metric-card">
            <div class="m-icon"><i class="ti ti-droplet" style="color:#3b82f6"></i></div>
            <div class="m-value"><%= emissions.water.toFixed(2) %></div>
            <div class="m-unit">tCO₂e<br>Water</div>
            <div class="m-plus">+</div>
          </div>
        </div>

        <!-- Scope breakdown -->
        <div class="scope-row">
          <div class="scope-card sc-1">
            <div class="sc-label">Scope 1</div>
            <div class="sc-val"><%= emissions.scope1.toFixed(2) %></div>
            <div class="sc-sub">tCO₂e · Direct</div>
          </div>
          <div class="scope-card sc-2">
            <div class="sc-label">Scope 2</div>
            <div class="sc-val"><%= emissions.scope2.toFixed(2) %></div>
            <div class="sc-sub">tCO₂e · Indirect</div>
          </div>
          <div class="scope-card sc-3">
            <div class="sc-label">Scope 3</div>
            <div class="sc-val"><%= emissions.scope3.toFixed(2) %></div>
            <div class="sc-sub">tCO₂e · Value chain</div>
          </div>
        </div>
      </div>

      <!-- Emissions by Source -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-chart-bar"></i>
          <h2>Emissions by Activity</h2>
        </div>
        <% if (activities && activities.length) { %>
          <% var maxValue = Math.max.apply(null, activities.map(function(a){ return a.value; })); %>
          <div class="bar-chart">
            <% activities.forEach(function(act) { %>
              <div class="bar-row">
                <span class="bar-label"><%= act.barLabel || act.name %></span>
                <div class="bar-track"><div class="bar-fill" style="width:<%= Math.round((act.value / maxValue) * 100) %>%;background:<%= act.barColor || '#1a6b6b' %>"></div></div>
                <span class="bar-val"><%= act.value.toFixed(2) %> t</span>
              </div>
            <% }); %>
          </div>
          <div class="kpi-list">
            <% activities.forEach(function(act) { %>
              <div class="kpi-item">
                <div class="kpi-left">
                  <div class="kpi-icon" style="background:<%= act.iconBg || '#fff8e6' %>"><i class="ti <%= act.icon || 'ti-flame' %>" style="color:<%= act.iconColor || '#a07000' %>"></i></div>
                  <div>
                    <div class="kpi-name"><%= act.name %></div>
                    <div class="kpi-desc"><%= act.scope %> · <%= act.category %> · <%= act.emissionFactor %> EF</div>
                  </div>
                </div>
                <div class="kpi-right">
                  <div class="kpi-val"><%= act.value.toFixed(2) %></div>
                  <div class="kpi-unit">tCO₂e</div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card-body"><p style="font-size:12.5px;color:var(--text-secondary)">No activity-level emissions data available.</p></div>
        <% } %>
      </div>

      <!-- Decarbonization -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-leaf"></i>
          <h2>Decarbonization & Net Zero</h2>
        </div>
        <div class="kpi-list">
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-target" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Decarbonization Impact</div>
                <div class="kpi-desc">Reduction achieved this reporting period</div>
              </div>
            </div>
            <div class="kpi-right">
              <div class="kpi-val"><%= decarbonization.impact.toFixed(2) %></div>
              <div class="kpi-unit">tCO₂e</div>
            </div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-calendar-check" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Net Zero Target Year</div>
                <div class="kpi-desc">Committed reduction milestone</div>
              </div>
            </div>
            <div class="kpi-right">
              <div class="kpi-val"><%= decarbonization.netZeroYear || '—' %></div>
              <div class="kpi-unit">year</div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- ══ TAB: Company Profile ══ -->
    <div class="tab-panel" id="tab-profile">

      <!-- Corporate Identity -->
      <div class="card" style="margin-top:10px">
        <div class="card-header">
          <i class="ti ti-building"></i>
          <h2>Corporate Information</h2>
        </div>
        <div class="card-body">
          <div class="info-grid">
            <div class="info-item">
              <div class="label">Company Name</div>
              <div class="value"><%= company.name %></div>
            </div>
            <div class="info-item">
              <div class="label">Industry</div>
              <div class="value"><%= company.industry %></div>
            </div>
            <div class="info-item">
              <div class="label">Company Type</div>
              <div class="value"><%= company.companyType %></div>
            </div>
            <div class="info-item">
              <div class="label">Registered</div>
              <div class="value"><%= company.registeredDate %></div>
            </div>
            <div class="info-item">
              <div class="label">Currency</div>
              <div class="value"><%= company.currency %></div>
            </div>
            <div class="info-item">
              <div class="label">Email</div>
              <div class="value"><a href="mailto:<%= company.email %>"><%= company.email %></a></div>
            </div>
            <div class="info-item">
              <div class="label">Phone</div>
              <div class="value"><%= company.phone %></div>
            </div>
            <div class="info-item">
              <div class="label">Website</div>
              <div class="value"><a href="<%= company.websiteUrl || '#' %>"><%= company.legalName || company.name %></a></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-map-pin"></i>
          <h2>Location</h2>
        </div>
        <div class="loc-grid">
          <div class="loc-block">
            <div class="loc-label">Address</div>
            <p><%- company.addressLines.join('<br>') %></p>
          </div>
          <div class="loc-block">
            <div class="loc-label">Timezone</div>
            <p><%= company.timezoneLabel %></p>
          </div>
        </div>
      </div>

      <!-- LCA Configuration -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-settings"></i>
          <h2>Sustainability & LCA Configuration</h2>
        </div>
        <div class="lca-strip">
          <div class="lca-item">
            <div class="ll">Reporting Year</div>
            <div class="lv"><%= lcaConfig.reportingYear || '—' %></div>
          </div>
          <div class="lca-item">
            <div class="ll">Base Year</div>
            <div class="lv"><%= lcaConfig.baseYear || '—' %></div>
          </div>
          <div class="lca-item">
            <div class="ll">Net Zero Target</div>
            <div class="lv"><%= lcaConfig.netZeroTarget || '—' %></div>
          </div>
        </div>
        <div class="lca-strip" style="border-top:1px solid var(--border)">
          <div class="lca-item">
            <div class="ll">LCA Goal</div>
            <div class="lv"><%= lcaConfig.lcaGoal || '—' %></div>
          </div>
          <div class="lca-item">
            <div class="ll">EF Region</div>
            <div class="lv"><%= lcaConfig.efRegion || '—' %></div>
          </div>
          <div class="lca-item">
            <div class="ll">Commitment</div>
            <div class="lv"><%= lcaConfig.commitment || '—' %></div>
          </div>
        </div>
      </div>

      <!-- Verification -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-shield-check"></i>
          <h2>Sustainability Assurance</h2>
        </div>
        <div class="kpi-list">
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e6f4f4"><i class="ti ti-certificate" style="color:#1a6b6b"></i></div>
              <div>
                <div class="kpi-name">Verifier Organization</div>
                <div class="kpi-desc">Third-party verification body</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val" style="font-size:12px;color:var(--text-secondary)"><%= assurance.verifierOrg || 'Not assigned' %></div></div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-check" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Assurance & QC Organization</div>
                <div class="kpi-desc">Quality check and assurance body</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val" style="font-size:12px;color:var(--text-secondary)"><%= assurance.qcOrg || 'Not assigned' %></div></div>
          </div>
        </div>
      </div>

      <!-- Certificates -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-award"></i>
          <h2>Company Certificates</h2>
        </div>
        <% if (certificates && certificates.length) { %>
          <div class="cert-list">
            <% certificates.forEach(function(cert) { %>
              <div class="cert-item">
                <div class="cert-left">
                  <div class="cert-icon"><i class="ti ti-certificate"></i></div>
                  <div>
                    <div class="cert-name"><%= cert.name %></div>
                    <div class="cert-issuer"><%= cert.issuer %></div>
                  </div>
                </div>
                <span class="cert-badge <%= cert.status === 'Active' ? 'active' : 'pending' %>"><%= cert.status %></span>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card-body"><p style="font-size:12.5px;color:var(--text-secondary)">No certificates on record.</p></div>
        <% } %>
        <div class="verified-row">
          <i class="ti ti-info-circle"></i>
          <span>Certificate details are self-reported and pending third-party verification.</span>
        </div>
      </div>

      <!-- About -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-file-text"></i>
          <h2>Business Overview</h2>
        </div>
        <div class="about-block">
          <h3>About Company</h3>
          <p><%= about.description %></p>
          <div class="about-divider"></div>
          <h3>Products & Services</h3>
          <p><%= about.productsServices %></p>
        </div>
      </div>

    </div>

    <!-- ══ TAB: Sustainability ══ -->
    <div class="tab-panel" id="tab-practices">

      <!-- Green KPIs -->
      <div class="card" style="margin-top:10px">
        <div class="card-header">
          <i class="ti ti-leaf"></i>
          <h2>Sustainability Metrics</h2>
        </div>
        <div class="kpi-list">
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-droplet" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Water Footprint</div>
                <div class="kpi-desc">Total water consumed across operations</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val"><%= sustainabilityMetrics.waterFootprint.toFixed(2) %></div><div class="kpi-unit">tCO₂e</div></div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#fff0e6"><i class="ti ti-trash" style="color:#c05c00"></i></div>
              <div>
                <div class="kpi-name">Waste Footprint</div>
                <div class="kpi-desc">Waste generated and disposal impact</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val"><%= sustainabilityMetrics.wasteFootprint.toFixed(2) %></div><div class="kpi-unit">tCO₂e</div></div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#eef2ff"><i class="ti ti-users" style="color:#3730a3"></i></div>
              <div>
                <div class="kpi-name">Employee Operations</div>
                <div class="kpi-desc">Commute and business travel impact</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val"><%= sustainabilityMetrics.employeeOps.toFixed(2) %></div><div class="kpi-unit">tCO₂e</div></div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-solar-panel" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Renewable Energy Use</div>
                <div class="kpi-desc">Share of renewables in total energy mix</div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val"><%= sustainabilityMetrics.renewableEnergyPct != null ? sustainabilityMetrics.renewableEnergyPct : '—' %></div><div class="kpi-unit">%</div></div>
          </div>
        </div>
      </div>

      <!-- Green Practices -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-recycle"></i>
          <h2>Green Practices & Waste Solutions</h2>
        </div>
        <% if (greenPractices && greenPractices.length) { %>
          <div class="practices-grid">
            <% greenPractices.forEach(function(practice) { %>
              <div class="practice-card">
                <div class="practice-img" style="background:linear-gradient(135deg,<%= practice.gradientFrom %>,<%= practice.gradientTo %>)">
                  <i class="ti <%= practice.icon %>" style="color:rgba(255,255,255,0.7)"></i>
                  <div class="img-label"><%= practice.title %></div>
                </div>
                <div class="practice-body">
                  <p><%= practice.description %></p>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="card-body"><p style="font-size:12.5px;color:var(--text-secondary)">No green practices recorded yet.</p></div>
        <% } %>
      </div>

      <!-- Verification -->
      <div class="card">
        <div class="card-header">
          <i class="ti ti-shield-check"></i>
          <h2>Data Verification</h2>
        </div>
        <div class="verified-row" style="border-top:none">
          <i class="ti ti-circle-check"></i>
          <span>Carbon data sourced from <%= dataVerification.dataSource %> · <%= emissions.reportingYear %></span>
        </div>
        <div class="kpi-list">
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e6f4f4"><i class="ti ti-database" style="color:#1a6b6b"></i></div>
              <div>
                <div class="kpi-name">Data Source</div>
                <div class="kpi-desc"><%= dataVerification.dataSource %></div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val" style="font-size:11.5px;color:var(--teal-mid)"><%= dataVerification.verified ? 'Verified' : 'Unverified' %></div></div>
          </div>
          <div class="kpi-item">
            <div class="kpi-left">
              <div class="kpi-icon" style="background:#e8f5ec"><i class="ti ti-calendar" style="color:#2d8a4e"></i></div>
              <div>
                <div class="kpi-name">Reporting Period</div>
                <div class="kpi-desc">Full Year · <%= emissions.reportingYear %></div>
              </div>
            </div>
            <div class="kpi-right"><div class="kpi-val" style="font-size:11.5px"><%= dataVerification.reportingPeriodLabel %></div></div>
          </div>
        </div>
      </div>

    </div>

    <div class="privacy-link"><a href="<%= privacyPolicyUrl || '#' %>">Privacy Policy</a></div>
    <div class="powered">Powered by <span><%= poweredByLabel || 'GreenStep LCA' %></span></div>

  </div>

  <!-- Bottom Nav -->
  <div class="bottom-nav">
    <button class="nav-btn active" onclick="switchTab('footprint', this); switchNav(this)">
      <i class="ti ti-home"></i>
      Home
    </button>
    <button class="nav-btn" onclick="switchTab('profile', this); switchNav(this)">
      <i class="ti ti-building"></i>
      Profile
    </button>
    <button class="nav-btn" onclick="switchTab('practices', this); switchNav(this)">
      <i class="ti ti-leaf"></i>
      Sustainability
    </button>
  </div>

  <script>
    function switchTab(name, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      document.querySelectorAll('.tab-pill').forEach(p => p.classList.remove('active'));
      const pillMap = { footprint: 0, profile: 1, practices: 2 };
      document.querySelectorAll('.tab-pill')[pillMap[name]].classList.add('active');
    }

    function switchNav(btn) {
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    document.querySelectorAll('.tab-pill').forEach((pill, i) => {
      const tabs = ['footprint', 'profile', 'practices'];
      pill.onclick = () => {
        switchTab(tabs[i]);
        document.querySelectorAll('.nav-btn').forEach((b, j) => b.classList.toggle('active', j === i));
      };
    });

    // Animate bars on load
    window.addEventListener('load', () => {
      document.querySelectorAll('.bar-fill').forEach(b => {
        const w = b.style.width;
        b.style.width = '0';
        setTimeout(() => b.style.width = w, 200);
      });
    });
  </script>

</body>
</html>
