<%
/**
 * COMBINED PASSPORT TEMPLATE — payload contract
 * ------------------------------------------------------------------
 * The Delegate Passport ALWAYS renders, with two true layout variants
 * switched purely by CSS media query (no JS, no server-side device
 * detection needed):
 *   - Mobile  (< 640px): dark "digital badge" card — dark header strip,
 *     photo+name+FULL ACCESS pill, entry QR box, footprint bar.
 *   - Desktop (>= 640px): full light card — header, role/org row,
 *     footprint section.
 * Both variants read the SAME data — nothing is duplicated in the payload.
 *
 * The Event Sustainability Passport is a separate card below, gated
 * by a single top-level flag:
 *
 *   flags.showEventPassport = true | false
 *
 * res.render('passport', {
 *   event: {                                   // shared event identity
 *     name, year, id, dates, venue, city, verified, myPassportUrl, logoUrl
 *   },
 *
 *   // ---- Company info shown in the Event Sustainability Passport header
 *   // (replaces the event name/dates line there) ----
 *   company: { name, description, logoUrl },
 *
 *   // ---- Delegate Passport data (always used, both variants) ----
 *   delegate:   { fullName, jobTitle, company, passType, photoUrl, idNumber },
 *   qr:         { imageUrl, label, sublabel },
 *   footprint:  {
 *     total, unit, offsetLabel,
 *     segments: [ { label, value, percent } ]
 *   },
 *
 *   // ---- Event Sustainability Passport data (only used if shown) ----
 *   // Top stat cards — mirrors the dashboard summary tiles
 *   // (Total Emissions / Scope 1-3 / Energy / Water / Waste / Decarbonization Impact).
 *   // Each key is optional; omit a key to show "—" for that card.
 *   // Card icons/colors are fixed in the template, not payload-driven.
 *   eventStats: {
 *     totalEmissions:        { value, unit },   // unit defaults to 'tCO2e'
 *     scope1:                { value, unit },
 *     scope2:                { value, unit },
 *     scope3:                { value, unit },
 *     energy:                { value, unit },
 *     water:                 { value, unit },
 *     waste:                 { value, unit },
 *     decarbonizationImpact: { value, unit }
 *   },
 *   eventBreakdown:       [ { label, percent } ],
 *   eventTravelByMode:    [ { mode, percent } ],
 *   eventCertifications:  [ 'ISO 20121 (events)', ... ],
 *
 *   branding: { primary, accent },   // optional overrides, shared by all cards
 *
 *   flags: {
 *     showFootprint: true,          // Delegate Passport footprint section
 *
 *     showEventPassport: true,      // whether to render the Event Sustainability Passport at all
 *
 *     // Optional fine-grained control WITHIN the event passport,
 *     // only relevant when showEventPassport is true
 *     showEventBreakdown: true,
 *     showEventTravelMode: true,
 *     showEventCertifications: true
 *   }
 * })
 * ------------------------------------------------------------------
 */

const event        = locals.event || {};
const company       = locals.company || {};
const delegate     = locals.delegate || {};
const qr           = locals.qr || {};
const footprint    = locals.footprint || {};
const footprintSegments = footprint.segments || [];

const eventStats   = locals.eventStats || {};
const eventBreakdown = locals.eventBreakdown || [];
const scopeBreakdown = locals.scopeBreakdown || [];
const intensityMetrics = locals.intensityMetrics || [];
const eventTravelByMode = locals.eventTravelByMode || [];
const eventCertifications = locals.eventCertifications || [];

const branding = Object.assign({ primary: '#0B2545', accent: '#14B8A6' }, locals.branding || {});

const flags = Object.assign({
  showFootprint: true,

  showEventPassport: true,
  showEventBreakdown: true,
  showEventTravelMode: true,
  showEventCertifications: true
}, locals.flags || {});

const fmtNum = (n) => (n === undefined || n === null || n === '') ? '—' : n;
const segmentColors = ['#0B2545', '#14B8A6', '#7C93B8', '#C7D2E0', '#E4E7EC'];

// helpers for the event stat cards (each stat is an optional { value, unit } object)
const statVal  = (s) => (s && s.value !== undefined && s.value !== null && s.value !== '') ? s.value : '—';
const statUnit = (s) => (s && s.unit) || 'tCO2e';

// fixed icon/color treatment per stat card — cosmetic only, not payload-driven
const statCardDefs = [
  { key: 'totalEmissions',        label: 'Total Emissions',        icon: '📦', bg: '#FDE8ED', color: '#D6336C' },
  { key: 'scope1',                label: 'Scope 1',                icon: '🏢', bg: '#E7EEFE', color: '#3B5BDB' },
  { key: 'scope2',                label: 'Scope 2',                icon: '📋', bg: '#FDEEDD', color: '#E8590C' },
  { key: 'scope3',                label: 'Scope 3',                icon: '🚚', bg: '#FDF3D8', color: '#C9971E' },
  { key: 'energy',                label: 'Energy',                 icon: '⚡', bg: '#FDEEDD', color: '#E8590C' },
  { key: 'water',                 label: 'Water',                  icon: '💧', bg: '#E3F2FD', color: '#1C7ED6' },
  { key: 'waste',                 label: 'Waste',                  icon: '🗑️', bg: '#F1E9FB', color: '#8B5FBF' },
  { key: 'decarbonizationImpact', label: 'Decarbonization Impact', icon: '📈', bg: '#E6F8EE', color: '#2F9E63', accent: true }
];

const companyLogo = company.companyUrl || company.logoUrl || event.logoUrl;
const delegateLogo = delegate.logoUrl || delegate.photoUrl;
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= fmtNum(delegate.fullName) %> · Passport</title>
<style>
  :root {
    --pp-primary: <%= branding.primary %>;
    --pp-accent: <%= branding.accent %>;
    --pp-ink: #16213A;
    --pp-muted: #6B7280;
    --pp-border: #E4E7EC;
    --pp-bg: #F5F6F8;
    --pp-card: #FFFFFF;
    --pp-track: #E9EBEF;
    --pp-radius-lg: 16px;
    --pp-radius-md: 10px;
    --pp-shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.08);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--pp-bg);
    font-family: 'Inter', 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--pp-ink);
    padding: 24px;
  }
  .pp-wrap { max-width: 980px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }

  .pp-card {
    background: var(--pp-card);
    border: 1px solid var(--pp-border);
    border-radius: var(--pp-radius-lg);
    box-shadow: var(--pp-shadow);
    overflow: hidden;
  }

  /* ===================================================================
     DELEGATE PASSPORT — two variants, toggled purely by media query.
     Default (mobile-first): show the dark digital-badge variant.
     From 640px up: show the full desktop card instead.
     =================================================================== */
  .pp-mobile-badge { display: block; max-width: 360px; margin: 0 auto; }
  .pp-desktop-card { display: none; }
  @media (min-width: 640px) {
    .pp-mobile-badge { display: none; }
    .pp-desktop-card { display: block; }
  }

  /* ---- Mobile digital badge ---- */
  .pp-badge-card {
    background: var(--pp-card);
    border-radius: var(--pp-radius-lg);
    box-shadow: var(--pp-shadow);
    overflow: hidden;
  }
  .pp-badge-topbar {
    background: var(--pp-primary);
    color: #fff;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .pp-badge-body { padding: 16px; }
  .pp-badge-id-row { display: flex; gap: 12px; align-items: center; margin-bottom: 16px; }
  .pp-badge-avatar {
    width: 56px; height: 56px; border-radius: 10px;
    background: var(--pp-track); background-size: cover; background-position: center;
    flex-shrink: 0;
  }
  .pp-badge-name { font-size: 15px; font-weight: 700; }
  .pp-badge-subline { font-size: 12px; color: var(--pp-muted); margin-top: 1px; }
  .pp-badge-pill {
    display: inline-block;
    margin-top: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border: 1px solid var(--pp-ink);
    border-radius: 999px;
  }

  .pp-badge-qr-row {
    display: flex; align-items: center; gap: 10px;
    border: 1px solid var(--pp-border); border-radius: var(--pp-radius-md);
    padding: 10px 12px; margin-bottom: 16px;
  }
  .pp-badge-qr-icon {
    width: 30px; height: 30px; border-radius: 5px;
    background: var(--pp-track); background-size: cover; background-position: center; flex-shrink: 0;
  }
  .pp-badge-qr-title { font-size: 12.5px; font-weight: 600; }
  .pp-badge-qr-sub { font-size: 11px; color: var(--pp-muted); }

  .pp-badge-section-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--pp-ink); margin-bottom: 8px;
  }

  .pp-badge-footprint { margin-bottom: 4px; }
  .pp-badge-fp-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .pp-badge-fp-value { font-size: 26px; font-weight: 800; }
  .pp-badge-fp-unit { font-size: 12px; color: var(--pp-muted); margin-left: 3px; }
  .pp-badge-fp-offset { font-size: 11.5px; color: var(--pp-accent); font-weight: 600; }
  .pp-badge-fp-track { display: flex; height: 6px; border-radius: 4px; overflow: hidden; background: var(--pp-track); margin-bottom: 6px; }
  .pp-badge-fp-seg { height: 100%; }
  .pp-badge-fp-legend { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--pp-muted); }

  .pp-badge-footer-note {
    font-size: 11.5px; color: var(--pp-muted); padding: 10px 4px 0; text-align: center;
  }
  .pp-badge-footer-note::before { content: "✎ "; }

  /* ===== shared bits used by desktop delegate card + event card ===== */
  .pp-header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid var(--pp-border);
    flex-wrap: wrap;
  }
  .pp-avatar {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--pp-track); background-size: cover; background-position: center;
    border: 1px solid var(--pp-border); flex-shrink: 0;
  }
  .pp-logo {
    width: 44px; height: 44px; border-radius: 10px;
    background: var(--pp-track); background-size: cover; background-position: center;
    flex-shrink: 0;
  }
  .pp-header-text { flex: 1; min-width: 200px; }
  .pp-header-text h1 { margin: 0; font-size: 18px; font-weight: 700; }
  .pp-header-text h1 .pp-suffix { font-weight: 500; color: var(--pp-muted); }
  .pp-header-text .pp-subline { margin-top: 2px; font-size: 13px; color: var(--pp-muted); line-height: 1.4; }

  .pp-note {
    font-size: 12.5px; color: var(--pp-muted);
    padding: 12px 24px; border-bottom: 1px solid var(--pp-border); background: #FAFBFC;
  }
  .pp-note::before { content: "✎ "; }
  .pp-footer-note { font-size: 12px; color: var(--pp-muted); padding: 4px 24px 20px; }
  .pp-footer-note::before { content: "✎ "; }

  .pp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 20px 24px; }
  .pp-grid.pp-grid-single { grid-template-columns: 1fr; }
  @media (max-width: 900px) { .pp-grid { grid-template-columns: 1fr; } }

  .pp-section { border: 1px solid var(--pp-border); border-radius: var(--pp-radius-md); padding: 16px; }
  .pp-section h2 { margin: 0 0 12px; font-size: 14px; font-weight: 700; }

  /* ===== Desktop delegate passport specifics ===== */
  .pp-meta-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center;
    padding: 20px 24px; border-bottom: 1px solid var(--pp-border);
  }
  @media (max-width: 900px) { .pp-meta-row { grid-template-columns: 1fr; } }
  .pp-meta-label { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--pp-muted); margin-bottom: 4px; }
  .pp-meta-value { font-size: 15px; font-weight: 700; }

  .pp-footprint-total { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  .pp-footprint-value { font-size: 30px; font-weight: 800; }
  .pp-footprint-unit { font-size: 13px; color: var(--pp-muted); margin-left: 4px; }
  .pp-footprint-offset { font-size: 12.5px; color: var(--pp-accent); font-weight: 600; }
  .pp-fp-segment { margin-bottom: 8px; }
  .pp-fp-segment-label { display: flex; justify-content: space-between; font-size: 12px; color: var(--pp-muted); margin-bottom: 3px; }
  .pp-fp-track { height: 6px; background: var(--pp-track); border-radius: 4px; overflow: hidden; }
  .pp-fp-fill { height: 100%; background: var(--pp-primary); border-radius: 4px; }

  /* ===== Event passport specifics ===== */
  .pp-badge-pip {
    display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600;
    padding: 6px 12px; border-radius: 999px; border: 1px solid var(--pp-accent); color: var(--pp-accent);
  }
  .pp-link-btn {
    font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--pp-border); color: var(--pp-ink); text-decoration: none; background: #FAFBFC;
  }
  .pp-header-actions { display: flex; gap: 8px; align-items: center; }

  /* ---- solid, icon-led stat tiles (Total Emissions, Scope 1-3, Energy, Water, Waste, Decarb.) ---- */
  .pp-stats-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
    padding: 20px 24px; background: #FAFBFC; border-bottom: 1px solid var(--pp-border);
  }
  @media (max-width: 700px) { .pp-stats-grid { grid-template-columns: repeat(2, 1fr); } }
  .pp-stat-card {
    background: var(--pp-card);
    border: 1px solid var(--pp-border);
    border-radius: var(--pp-radius-md);
    box-shadow: var(--pp-shadow);
    padding: 14px 16px;
  }
  .pp-stat-icon {
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; margin-bottom: 12px;
  }
  .pp-stat-label { font-size: 12px; color: var(--pp-muted); margin-bottom: 4px; }
  .pp-stat-value { font-size: 20px; font-weight: 800; }
  .pp-stat-unit { font-size: 11px; font-weight: 600; color: var(--pp-muted); margin-left: 2px; }
  .pp-stat-value.pp-accent-value { color: var(--pp-accent); }

  .pp-stack-track { display: flex; height: 10px; border-radius: 6px; overflow: hidden; background: var(--pp-track); margin-bottom: 10px; }
  .pp-stack-seg { height: 100%; }
  .pp-legend { display: flex; flex-wrap: wrap; gap: 10px 16px; font-size: 12px; color: var(--pp-muted); }
  .pp-legend-item { display: flex; align-items: center; gap: 6px; }
  .pp-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

  .pp-mode-row { margin-bottom: 10px; }
  .pp-mode-label { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 4px; }
  .pp-mode-track { height: 8px; background: var(--pp-track); border-radius: 5px; overflow: hidden; }
  .pp-mode-fill { height: 100%; background: var(--pp-accent); border-radius: 5px; }

  .pp-certs { display: flex; flex-wrap: wrap; gap: 10px; padding: 16px 24px; border-top: 1px solid var(--pp-border); }
  .pp-cert-pill { font-size: 12.5px; font-weight: 600; padding: 8px 16px; border: 1px solid var(--pp-border); border-radius: 999px; }
  .pp-report-header { display: flex; justify-content: space-between; gap: 24px; padding: 28px 24px 20px; border-bottom: 1px solid var(--pp-border); }
  .pp-report-company { font-size: 22px; font-weight: 800; }
  .pp-report-address { margin-top: 6px; font-size: 12px; line-height: 1.5; color: var(--pp-muted); white-space: pre-line; }
  .pp-scope-layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px; }
  .pp-scope-row { margin-bottom: 12px; }
  .pp-scope-label { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; margin-bottom: 4px; }
  .pp-scope-track { height: 8px; background: var(--pp-track); border-radius: 5px; overflow: hidden; }
  .pp-scope-fill { height: 100%; background: var(--pp-primary); }
  .pp-scope-detail { border-bottom: 1px solid var(--pp-border); padding: 9px 0; }
  .pp-scope-detail:last-child { border-bottom: none; }
  .pp-scope-detail-head { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; font-weight: 700; }
  .pp-scope-item { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0 0 16px; font-size: 12px; color: var(--pp-muted); }
  .pp-kpi-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .pp-kpi-table th, .pp-kpi-table td { border-bottom: 1px solid var(--pp-border); padding: 10px 0; text-align: left; }
  .pp-kpi-table th:last-child, .pp-kpi-table td:last-child { text-align: right; }
  @media (max-width: 700px) { .pp-report-header, .pp-scope-layout { grid-template-columns: 1fr; display: grid; } }
</style>
</head>
<body>
<div class="pp-wrap">

  <!-- ================= DELEGATE PASSPORT (always shown) ================= -->

  <!-- ---- Mobile digital-badge variant (< 640px) ---- -->
  <div class="pp-mobile-badge">
    <div class="pp-badge-card">
      <div class="pp-badge-topbar">
        <span>Delegate · <%= fmtNum(event.name) %> <%= fmtNum(event.year) %></span>
        <span>✓</span>
      </div>
      <div class="pp-badge-body">
        <div class="pp-badge-id-row">
          <div class="pp-badge-avatar" <% if (delegateLogo) { %>style="background-image:url('<%= delegateLogo %>')"<% } %>></div>
          <div>
            <div class="pp-badge-name"><%= fmtNum(delegate.fullName) %></div>
            <div class="pp-badge-subline"><%= fmtNum(delegate.jobTitle) %></div>
            <div class="pp-badge-subline"><%= fmtNum(delegate.company) %></div>
            <span class="pp-badge-pill"><%= (delegate.passType || 'Full access').toUpperCase() %></span>
          </div>
        </div>

        <div class="pp-badge-qr-row">
          <div class="pp-badge-qr-icon" <% if (qr.imageUrl) { %>style="background-image:url('<%= qr.imageUrl %>')"<% } %>></div>
          <div>
            <div class="pp-badge-qr-title">Entry / session check-in</div>
            <div class="pp-badge-qr-sub">Show this QR at doors</div>
          </div>
        </div>

        <% if (flags.showFootprint) { %>
        <div class="pp-badge-section-label">My Carbon footprint</div>
        <div class="pp-badge-footprint">
          <div class="pp-badge-fp-row">
            <div><span class="pp-badge-fp-value"><%= fmtNum(footprint.total) %></span><span class="pp-badge-fp-unit"><%= footprint.unit || 'tCO2e' %></span></div>
            <% if (footprint.offsetLabel) { %><div class="pp-badge-fp-offset"><%= footprint.offsetLabel %></div><% } %>
          </div>
          <div class="pp-badge-fp-track">
            <% footprintSegments.forEach(function(seg, i) { %>
              <div class="pp-badge-fp-seg" style="width: <%= seg.percent || 0 %>%; background: <%= segmentColors[i % segmentColors.length] %>"></div>
            <% }); %>
          </div>
          <div class="pp-badge-fp-legend">
            <% footprintSegments.forEach(function(seg) { %><span><%= seg.label %></span><% }); %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
    <!-- <div class="pp-badge-footer-note">Doubles as the live entry badge AND a record of the delegate's own footprint.</div> -->
  </div>

  <!-- ---- Desktop card variant (>= 640px) ---- -->
  <div class="pp-desktop-card">
    <div class="pp-card">

      <div class="pp-header">
        <div class="pp-avatar" <% if (delegateLogo) { %>style="background-image:url('<%= delegateLogo %>')"<% } %>></div>
        <div class="pp-header-text">
          <h1><%= fmtNum(delegate.fullName) %> <span class="pp-suffix">· Delegate Passport</span></h1>
        </div>
      </div>

      <div class="pp-meta-row">
        <div>
          <div class="pp-meta-label">Role</div>
          <div class="pp-meta-value"><%= fmtNum(delegate.jobTitle) %></div>
        </div>
        <div>
          <div class="pp-meta-label">Organization</div>
          <div class="pp-meta-value"><%= fmtNum(delegate.company) %></div>
        </div>
      </div>

      <!-- <div class="pp-note">Identity is the hero — the thing a delegate opens most.</div> -->

      <% if (flags.showFootprint) { %>
      <div class="pp-grid pp-grid-single">
        <div class="pp-section">
          <h2>My Carbon footprint</h2>
          <div class="pp-footprint-total">
            <div>
              <span class="pp-footprint-value"><%= fmtNum(footprint.total) %></span>
              <span class="pp-footprint-unit"><%= footprint.unit || 'tCO2e' %></span>
            </div>
            <% if (footprint.offsetLabel) { %><div class="pp-footprint-offset"><%= footprint.offsetLabel %></div><% } %>
          </div>
          <% footprintSegments.forEach(function(seg) { %>
            <div class="pp-fp-segment">
              <div class="pp-fp-segment-label"><span><%= seg.label %></span><span><%= seg.value %></span></div>
              <div class="pp-fp-track"><div class="pp-fp-fill" style="width: <%= seg.percent || 0 %>%"></div></div>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- <div class="pp-footer-note">Privacy-first — only consented fields are shared when networking.</div> -->
    </div>
  </div>

  <!-- ================= EVENT SUSTAINABILITY PASSPORT (flag-controlled) ================= -->
  <% if (flags.showEventPassport) { %>
  <div class="pp-card">

    <div class="pp-report-header">
      <div>
        <div class="pp-logo" <% if (companyLogo) { %>style="background-image:url('<%= companyLogo %>')"<% } %>></div>
        <div class="pp-report-company"><%= fmtNum(company.name) %></div>
        <% if (company.address) { %><div class="pp-report-address"><%= company.address %></div><% } %>
      </div>
    </div>

    <!-- Summary stat cards — solid icon tiles, mirrors the dashboard -->
    <div class="pp-stats-grid">
      <% statCardDefs.forEach(function(def) { %>
      <div class="pp-stat-card">
        <div class="pp-stat-icon" style="background: <%= def.bg %>; color: <%= def.color %>;"><%= def.icon %></div>
        <div class="pp-stat-label"><%= def.label %></div>
        <div class="pp-stat-value<% if (def.accent) { %> pp-accent-value<% } %>">
          <%= statVal(eventStats[def.key]) %> <span class="pp-stat-unit"><%= statUnit(eventStats[def.key]) %></span>
        </div>
      </div>
      <% }); %>
    </div>

    <div class="pp-grid">

      <% if (flags.showEventBreakdown) { %>
      <div class="pp-section">
        <h2>Footprint breakdown</h2>
        <div class="pp-stack-track">
          <% eventBreakdown.forEach(function(seg, i) { %>
            <div class="pp-stack-seg" style="width: <%= seg.percent || 0 %>%; background: <%= segmentColors[i % segmentColors.length] %>"></div>
          <% }); %>
        </div>
        <div class="pp-legend">
          <% eventBreakdown.forEach(function(seg, i) { %>
            <div class="pp-legend-item">
              <span class="pp-legend-dot" style="background: <%= segmentColors[i % segmentColors.length] %>"></span>
              <span><%= seg.label %> <%= seg.percent %>%</span>
            </div>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (flags.showEventTravelMode) { %>
      <div class="pp-section">
        <h2>Delegate travel by mode</h2>
        <% eventTravelByMode.forEach(function(m) { %>
          <div class="pp-mode-row">
            <div class="pp-mode-label"><span><%= m.mode %></span><span><%= m.percent %>%</span></div>
            <div class="pp-mode-track"><div class="pp-mode-fill" style="width: <%= m.percent || 0 %>%"></div></div>
          </div>
        <% }); %>
      </div>
      <% } %>

    </div>

    <% if (scopeBreakdown.length) { %>
    <div class="pp-grid pp-grid-single">
      <div class="pp-section">
        <h2>Emissions Breakdown by Scope</h2>
        <div class="pp-scope-layout">
          <div>
            <% scopeBreakdown.forEach(function(scope) { %>
            <div class="pp-scope-row">
              <div class="pp-scope-label"><span><%= scope.scope %> - <%= scope.label %></span><span><%= scope.value %> <%= scope.unit || 'tCO2e' %></span></div>
              <div class="pp-scope-track"><div class="pp-scope-fill" style="width: <%= scope.percent || 0 %>%"></div></div>
            </div>
            <% }); %>
          </div>
          <div>
            <% scopeBreakdown.forEach(function(scope) { %>
            <div class="pp-scope-detail">
              <div class="pp-scope-detail-head"><span><%= scope.scope %> - <%= scope.label %></span><span><%= scope.value %> <%= scope.unit || 'tCO2e' %></span></div>
              <% (scope.items || []).forEach(function(item) { %>
              <div class="pp-scope-item"><span><%= item.label %></span><span><%= item.value %> <%= item.unit || scope.unit || 'tCO2e' %></span></div>
              <% }); %>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (intensityMetrics.length) { %>
    <div class="pp-grid pp-grid-single">
      <div class="pp-section">
        <h2>Emissions Intensity Metrics</h2>
        <table class="pp-kpi-table">
          <thead><tr><th>KPI Metric</th><th>Value</th></tr></thead>
          <tbody>
            <% intensityMetrics.forEach(function(metric) { %>
            <tr><td><%= metric.label %></td><td><%= metric.value %> <%= metric.unit || 'tCO2e' %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <!-- <div class="pp-footer-note">Same module language as the company & facility passports — consistent, comparable, public.</div> -->
  </div>
  <% } %>

</div>
</body>
</html>
