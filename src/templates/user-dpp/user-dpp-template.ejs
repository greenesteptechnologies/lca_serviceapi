<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= user.displayName %> · Digital Passport</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #142822;
      --ink-soft: #4c5850;
      --forest: #1f4a3a;
      --forest-deep: #0f2b21;
      --paper: #eef0e9;
      --paper-card: #f8f8f4;
      --brass: #a9782e;
      --brass-light: #d8b876;
      --line: #cdd3c5;
      --line-strong: #a9b4a3;
      --good: #2f6b4f;
    }
    * { box-sizing: border-box; }
    html { -webkit-font-smoothing: antialiased; }
    body {
      margin: 0;
      background: var(--paper);
      background-image:
        radial-gradient(circle at 1px 1px, rgba(20,40,34,0.07) 1px, transparent 0);
      background-size: 14px 14px;
      color: var(--ink);
      font-family: "Inter", sans-serif;
      line-height: 1.45;
    }
    main {
      max-width: 640px;
      margin: 0 auto;
      padding: 32px 18px 56px;
    }

    /* ---- Passport folio ---- */
    .folio {
      background: var(--paper-card);
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      box-shadow: 0 1px 0 rgba(20,40,34,0.04), 0 18px 40px -24px rgba(15,43,33,0.35);
      overflow: hidden;
    }

    /* header band */
    .band {
      position: relative;
      background:
        linear-gradient(160deg, var(--forest) 0%, var(--forest-deep) 100%);
      color: #eef3ee;
      padding: 30px 26px 26px;
    }
    .band::after {
      content: "";
      position: absolute; inset: 0;
      background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 34px);
      pointer-events: none;
    }
    .band-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      position: relative;
    }
    .doc-type {
      font-family: "Space Mono", monospace;
      font-size: 11px;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: #bcd0c3;
    }
    .org {
      font-family: "Space Mono", monospace;
      font-size: 11px;
      letter-spacing: .04em;
      color: #cfe0d4;
      margin-top: 3px;
    }
    .seal {
      flex-shrink: 0;
      width: 46px; height: 46px;
      border-radius: 50%;
      border: 1.5px solid var(--brass-light);
      display: flex; align-items: center; justify-content: center;
      font-family: "Fraunces", serif;
      font-size: 17px;
      color: var(--brass-light);
      background: rgba(169,120,46,0.12);
    }
    h1 {
      font-family: "Fraunces", serif;
      font-weight: 600;
      font-size: 30px;
      letter-spacing: -0.01em;
      margin: 20px 0 3px;
      position: relative;
    }
    .role-line {
      font-size: 14px;
      color: #cfe0d4;
      margin: 0;
      position: relative;
    }
    .role-line .sep { color: var(--brass-light); margin: 0 7px; }

    /* body */
    .body-pad { padding: 24px 26px 28px; }

    .field-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border: 1px solid var(--line);
      border-radius: 2px;
      overflow: hidden;
    }
    .field {
      padding: 13px 16px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .field:nth-child(2n) { border-right: none; }
    .field-label {
      font-family: "Space Mono", monospace;
      font-size: 10px;
      letter-spacing: .09em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-bottom: 4px;
    }
    .field-value {
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
    }

    /* total emissions — stamped seal */
    .stamp-row {
      display: flex;
      align-items: center;
      gap: 20px;
      margin: 26px 0 4px;
      padding: 18px 20px;
      border: 1.5px dashed var(--brass);
      border-radius: 3px;
      background: rgba(169,120,46,0.05);
    }
    .stamp {
      flex-shrink: 0;
      width: 76px; height: 76px;
      border-radius: 50%;
      border: 2px solid var(--brass);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transform: rotate(-6deg);
      color: var(--brass);
      font-family: "Space Mono", monospace;
    }
    .stamp b { font-size: 18px; line-height: 1; font-family: "Fraunces", serif; color: var(--forest-deep); }
    .stamp span { font-size: 8px; letter-spacing: .06em; margin-top: 2px; }
    .stamp-copy .label { font-family: "Space Mono", monospace; font-size: 10px; letter-spacing: .09em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 3px; }
    .stamp-copy .value { font-family: "Fraunces", serif; font-size: 24px; font-weight: 600; color: var(--forest-deep); }
    .stamp-copy .value small { font-family: "Inter", sans-serif; font-size: 13px; font-weight: 500; color: var(--ink-soft); margin-left: 4px; }

    /* activity breakdown */
    h2 {
      font-family: "Fraunces", serif;
      font-size: 15px;
      font-weight: 600;
      margin: 30px 0 12px;
      display: flex; align-items: center; gap: 9px;
    }
    h2::before { content: ""; width: 16px; height: 1px; background: var(--brass); display: inline-block; }

    .bars { display: flex; flex-direction: column; gap: 11px; }
    .bar-row { display: grid; grid-template-columns: 108px 1fr 62px; align-items: center; gap: 12px; }
    .bar-name { font-size: 12.5px; color: var(--ink-soft); }
    .bar-track { height: 7px; background: var(--line); border-radius: 4px; overflow: hidden; }
    .bar-fill { height: 100%; width: var(--fill, 0%); background: linear-gradient(90deg, var(--forest), var(--good)); border-radius: 4px; }
    .bar-val { font-family: "Space Mono", monospace; font-size: 12px; text-align: right; color: var(--ink); }

    /* status row */
    .status-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 14px;
      margin-top: 26px;
    }
    .status-card .field-label { margin-bottom: 6px; }
    .badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 10px 5px 8px;
      background: rgba(47,107,79,0.1);
      color: var(--good);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--good); }
    .status-card .field-value.mono { font-family: "Space Mono", monospace; font-weight: 400; font-size: 13px; }

    /* perforation + MRZ */
    .perf {
      height: 0;
      border-top: 1.5px dashed var(--line-strong);
      position: relative;
      margin: 30px 0 0;
    }
    .perf::before, .perf::after {
      content: "";
      position: absolute; top: -7px;
      width: 14px; height: 14px;
      background: var(--paper);
      border-radius: 50%;
    }
    .perf::before { left: -33px; }
    .perf::after { right: -33px; }

    .mrz {
      background: var(--forest-deep);
      color: #dceadf;
      padding: 18px 26px 22px;
    }
    .mrz-line {
      font-family: "Space Mono", monospace;
      font-size: 12.5px;
      letter-spacing: .11em;
      color: #b9d4c4;
      white-space: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .mrz-line::-webkit-scrollbar { display: none; }
    .mrz-line + .mrz-line { margin-top: 5px; }
    .mrz-caption {
      font-family: "Space Mono", monospace;
      font-size: 9.5px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #6f8a7a;
      margin-bottom: 10px;
    }

    footer.note {
      max-width: 640px;
      margin: 16px auto 0;
      color: var(--ink-soft);
      font-size: 11.5px;
      text-align: center;
      padding: 0 18px;
    }

    @media (max-width: 480px) {
      .field-grid { grid-template-columns: 1fr; }
      .field:nth-child(2n) { border-right: 1px solid var(--line); }
      .status-grid { grid-template-columns: 1fr; }
      .bar-row { grid-template-columns: 84px 1fr 54px; }
      h1 { font-size: 25px; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>
<%
  // Helper: derive MRZ-style code line from real fields (no fabricated data).
  const mrzName = (user.displayName || '').toUpperCase().replace(/[^A-Z ]/g, '').replace(/\s+/g, '<');
  const mrzOrg = (organizationLabel || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 12);
  const mrzYear = String(emissions.reportingYear);
  const mrzTotal = emissions.total.toFixed(2).replace('.', '');
%>
  <main>
    <div class="folio">
      <div class="band">
        <div class="band-top">
          <div>
            <div class="doc-type">Digital User Passport</div>
            <div class="org"><%= organizationLabel %></div>
          </div>
          <div class="seal">DP</div>
        </div>
        <h1><%= user.displayName %></h1>
        <p class="role-line"><%= user.designation %><span class="sep">·</span><%= user.workModel %></p>
      </div>

      <div class="body-pad">
        <div class="field-grid">
          <div class="field">
            <div class="field-label">Department</div>
            <div class="field-value"><%= user.department || 'Not disclosed' %></div>
          </div>
          <div class="field">
            <div class="field-label">Location</div>
            <div class="field-value"><%= user.location || 'Not disclosed' %></div>
          </div>
          <div class="field">
            <div class="field-label">Reporting Year</div>
            <div class="field-value"><%= emissions.reportingYear %></div>
          </div>
          <div class="field">
            <div class="field-label">Activities Recorded</div>
            <div class="field-value"><%= activityCount %></div>
          </div>
        </div>

        <div class="stamp-row">
          <div class="stamp"><b><%= emissions.total.toFixed(1) %></b><span>tCO2e</span></div>
          <div class="stamp-copy">
            <div class="label">Total User Emissions</div>
            <div class="value"><%= emissions.total.toFixed(2) %><small>tCO2e for <%= emissions.reportingYear %></small></div>
          </div>
        </div>

        <h2>Emissions by Activity</h2>
        <%
          const activities = [
            ['Business travel', emissions.businessTravel],
            ['Daily commute', emissions.dailyCommute],
            ['Accommodation', emissions.accommodation],
            ['Remote work', emissions.remoteWork],
            ['Home electricity', emissions.homeElectricity],
            ['Device energy', emissions.deviceEnergy],
          ];
          const maxVal = Math.max(...activities.map(a => a[1]), 0.0001);
        %>
        <div class="bars">
          <% activities.forEach(function(a) { %>
          <div class="bar-row">
            <div class="bar-name"><%= a[0] %></div>
            <% const pct = Math.max((a[1] / maxVal) * 100, 3).toFixed(1); %>
            <div class="bar-track"><div class="bar-fill" style="--fill: <%= pct %>%"></div></div>
            <div class="bar-val"><%= a[1].toFixed(2) %></div>
          </div>
          <% }); %>
        </div>

        <div class="status-grid">
          <div class="status-card">
            <div class="field-label">Sustainability Score</div>
            <div class="field-value"><%= sustainabilityScore == null ? 'Not available' : sustainabilityScore %></div>
          </div>
          <div class="status-card">
            <div class="field-label">Verification</div>
            <span class="badge"><%= verificationStatus %></span>
          </div>
          <div class="status-card">
            <div class="field-label">Last Calculated</div>
            <div class="field-value mono"><%= lastCalculationDate %></div>
          </div>
        </div>
      </div>

      <div class="perf"></div>
      <div class="mrz">
        <div class="mrz-caption">Machine Readable Zone</div>
        <div class="mrz-line">DP&lt;USR&lt;&lt;<%= mrzName %>&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</div>
        <div class="mrz-line"><%= mrzOrg %><%= mrzYear %>IND&lt;&lt;T&lt;<%= mrzTotal %>&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;1</div>
      </div>
    </div>

    <footer class="note">This passport contains anonymized, aggregated personal sustainability data.</footer>
  </main>
</body>
</html>
