<%
/**
 * COMBINED USER PASSPORT — Delegate-style UI
 * ------------------------------------------------------------------
 * Existing User Passport data is preserved:
 *
 * user: {
 *   displayName,
 *   designation,
 *   workModel,
 *   department,
 *   location
 * }
 *
 * organizationLabel
 * emissions: {
 *   reportingYear,
 *   total,
 *   businessTravel,
 *   dailyCommute,
 *   accommodation,
 *   remoteWork,
 *   homeElectricity,
 *   deviceEnergy
 * }
 *
 * activityCount
 * sustainabilityScore
 * verificationStatus
 * lastCalculationDate
 *
 * Optional:
 * user.photoUrl
 * user.idNumber
 * qr.imageUrl
 *
 * Optional flags:
 * flags.showActivityBreakdown
 * flags.showSustainability
 * flags.showVerification
 * flags.showMetadata
 * ------------------------------------------------------------------
 */

const user = locals.user || {};
const emissions = locals.emissions || {};

const organizationLabel = locals.organizationLabel || '';
const activityCount = locals.activityCount ?? 0;
const sustainabilityScore = locals.sustainabilityScore;
const verificationStatus = locals.verificationStatus || 'Not verified';
const lastCalculationDate = locals.lastCalculationDate || '—';

const qr = locals.qr || {};

const flags = Object.assign({
  showActivityBreakdown: true,
  showSustainability: true,
  showVerification: true,
  showMetadata: true
}, locals.flags || {});

const branding = Object.assign({
  primary: '#0B2545',
  accent: '#14B8A6'
}, locals.branding || {});

const fmtNum = (n) =>
  (n === undefined || n === null || n === '') ? '—' : n;

const fmtEmission = (n) =>
  (n === undefined || n === null || n === '' || Number.isNaN(Number(n)))
    ? '0.00'
    : Number(n).toFixed(2);

const segmentColors = [
  '#0B2545',
  '#14B8A6',
  '#7C93B8',
  '#C7D2E0',
  '#E4E7EC'
];

/*
 * Existing activity fields preserved exactly.
 */
const activities = [
  ['Business travel', Number(emissions.businessTravel) || 0],
  ['Daily commute', Number(emissions.dailyCommute) || 0],
  ['Accommodation', Number(emissions.accommodation) || 0],
  ['Remote work', Number(emissions.remoteWork) || 0],
  ['Home electricity', Number(emissions.homeElectricity) || 0],
  ['Device energy', Number(emissions.deviceEnergy) || 0]
];

const maxActivityValue = Math.max(
  ...activities.map(function (a) { return a[1]; }),
  0.0001
);

/*
 * Convert activities into the same segment/bar data language
 * used by the Delegate Passport.
 */
const activitySegments = activities.map(function (a) {
  return {
    label: a[0],
    value: a[1],
    percent: Math.max((a[1] / maxActivityValue) * 100, 3)
  };
});

/*
 * MRZ-style values retained from the original User Passport.
 * No fabricated data.
 */
const mrzName = (user.displayName || '')
  .toUpperCase()
  .replace(/[^A-Z ]/g, '')
  .replace(/\s+/g, '<');

const mrzOrg = (organizationLabel || '')
  .toUpperCase()
  .replace(/[^A-Z0-9]/g, '')
  .slice(0, 12);

const mrzYear = String(emissions.reportingYear || '');
const mrzTotal = Number(emissions.total || 0)
  .toFixed(2)
  .replace('.', '');

const userName = fmtNum(user.displayName);
const userRole = fmtNum(user.designation);
const userOrg = fmtNum(organizationLabel);
const userWorkModel = fmtNum(user.workModel);
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= userName %> · Digital Passport</title>

  <style>
    :root {
      --pp-primary: <%= branding.primary %>;
      --pp-accent: <%= branding.accent %>;

      --pp-ink: #16213A;
      --pp-muted: #6B7280;
      --pp-border: #E4E7EC;
      --pp-bg: #F5F6F8;
      --pp-card: #FFFFFF;
      --pp-track: #E9EBEF;

      --pp-radius-lg: 16px;
      --pp-radius-md: 10px;

      --pp-shadow:
        0 1px 2px rgba(16, 24, 40, 0.06),
        0 1px 3px rgba(16, 24, 40, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    html {
      -webkit-font-smoothing: antialiased;
    }

    body {
      margin: 0;
      background: var(--pp-bg);
      color: var(--pp-ink);

      font-family:
        'Inter',
        'Manrope',
        -apple-system,
        BlinkMacSystemFont,
        sans-serif;

      line-height: 1.45;
      padding: 24px;
    }

    .pp-wrap {
      max-width: 980px;
      margin: 0 auto;

      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .pp-card {
      background: var(--pp-card);
      border: 1px solid var(--pp-border);
      border-radius: var(--pp-radius-lg);
      box-shadow: var(--pp-shadow);
      overflow: hidden;
    }


    /* ================================================================
       USER PASSPORT
       Two variants:
       <640px  = mobile digital badge
       >=640px = full desktop passport
       ================================================================ */

    .pp-mobile-badge {
      display: block;
      max-width: 360px;
      margin: 0 auto;
    }

    .pp-desktop-card {
      display: none;
    }

    @media (min-width: 640px) {
      .pp-mobile-badge {
        display: none;
      }

      .pp-desktop-card {
        display: block;
      }
    }


    /* ================================================================
       MOBILE DIGITAL USER BADGE
       ================================================================ */

    .pp-badge-card {
      background: var(--pp-card);
      border-radius: var(--pp-radius-lg);
      box-shadow: var(--pp-shadow);
      overflow: hidden;
    }

    .pp-badge-topbar {
      background: var(--pp-primary);
      color: #fff;

      padding: 12px 16px;

      display: flex;
      justify-content: space-between;
      align-items: center;

      font-size: 12px;
      font-weight: 700;

      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .pp-badge-body {
      padding: 16px;
    }

    .pp-badge-id-row {
      display: flex;
      gap: 12px;
      align-items: center;

      margin-bottom: 16px;
    }

    .pp-badge-avatar {
      width: 56px;
      height: 56px;

      border-radius: 10px;

      background:
        var(--pp-track);

      background-size: cover;
      background-position: center;

      flex-shrink: 0;
    }

    .pp-badge-avatar-initials {
      width: 56px;
      height: 56px;

      border-radius: 10px;

      display: flex;
      align-items: center;
      justify-content: center;

      background: var(--pp-primary);
      color: #fff;

      font-size: 18px;
      font-weight: 800;

      flex-shrink: 0;
    }

    .pp-badge-name {
      font-size: 15px;
      font-weight: 700;
    }

    .pp-badge-subline {
      font-size: 12px;
      color: var(--pp-muted);
      margin-top: 1px;
    }

    .pp-badge-pill {
      display: inline-block;

      margin-top: 6px;

      font-size: 10px;
      font-weight: 700;

      letter-spacing: 0.04em;

      padding: 3px 10px;

      border: 1px solid var(--pp-ink);
      border-radius: 999px;
    }


    /* Mobile identity */

    .pp-badge-identity {
      display: grid;
      grid-template-columns: 1fr 1fr;

      border: 1px solid var(--pp-border);
      border-radius: var(--pp-radius-md);

      overflow: hidden;

      margin-bottom: 16px;
    }

    .pp-badge-field {
      padding: 9px 10px;
      border-bottom: 1px solid var(--pp-border);
    }

    .pp-badge-field:nth-child(odd) {
      border-right: 1px solid var(--pp-border);
    }

    .pp-badge-field:nth-last-child(-n + 2) {
      border-bottom: none;
    }

    .pp-badge-field-label {
      font-size: 9px;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.05em;

      color: var(--pp-muted);

      margin-bottom: 2px;
    }

    .pp-badge-field-value {
      font-size: 11.5px;
      font-weight: 600;
    }


    /* Mobile emissions */

    .pp-badge-section-label {
      font-size: 11px;
      font-weight: 700;

      text-transform: uppercase;
      letter-spacing: 0.04em;

      color: var(--pp-ink);

      margin-bottom: 8px;
    }

    .pp-badge-footprint {
      margin-bottom: 16px;
    }

    .pp-badge-fp-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;

      margin-bottom: 8px;
    }

    .pp-badge-fp-value {
      font-size: 26px;
      font-weight: 800;
    }

    .pp-badge-fp-unit {
      font-size: 12px;
      color: var(--pp-muted);
      margin-left: 3px;
    }

    .pp-badge-fp-offset {
      font-size: 11.5px;
      color: var(--pp-accent);
      font-weight: 600;
    }

    .pp-badge-fp-track {
      display: flex;

      height: 6px;

      border-radius: 4px;
      overflow: hidden;

      background: var(--pp-track);

      margin-bottom: 6px;
    }

    .pp-badge-fp-seg {
      height: 100%;
    }

    .pp-badge-fp-legend {
      display: flex;
      justify-content: space-between;

      gap: 6px;

      font-size: 9.5px;
      color: var(--pp-muted);

      overflow: hidden;
    }

    .pp-badge-fp-legend span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }


    /* Mobile status */

    .pp-badge-status-row {
      display: flex;
      align-items: center;
      gap: 10px;

      border: 1px solid var(--pp-border);
      border-radius: var(--pp-radius-md);

      padding: 10px 12px;

      margin-bottom: 10px;
    }

    .pp-badge-status-icon {
      width: 28px;
      height: 28px;

      border-radius: 50%;

      background: rgba(20, 184, 166, 0.12);
      color: var(--pp-accent);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 13px;
      font-weight: 800;

      flex-shrink: 0;
    }

    .pp-badge-status-title {
      font-size: 12.5px;
      font-weight: 600;
    }

    .pp-badge-status-sub {
      font-size: 11px;
      color: var(--pp-muted);
    }

    .pp-badge-info-btn {
      margin-left: auto;

      width: 20px;
      height: 20px;

      border-radius: 50%;

      border: 1px solid var(--pp-border);
      color: var(--pp-muted);

      font-size: 10px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;
    }


    /* ================================================================
       SHARED DESKTOP COMPONENTS
       ================================================================ */

    .pp-header {
      display: flex;
      align-items: center;
      gap: 16px;

      padding: 20px 24px;

      border-bottom: 1px solid var(--pp-border);

      flex-wrap: wrap;
    }

    .pp-avatar {
      width: 64px;
      height: 64px;

      border-radius: 50%;

      background: var(--pp-track);

      background-size: cover;
      background-position: center;

      border: 1px solid var(--pp-border);

      flex-shrink: 0;
    }

    .pp-avatar-initials {
      width: 64px;
      height: 64px;

      border-radius: 50%;

      background: var(--pp-primary);
      color: #fff;

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 20px;
      font-weight: 800;

      border: 1px solid var(--pp-border);

      flex-shrink: 0;
    }

    .pp-header-text {
      flex: 1;
      min-width: 200px;
    }

    .pp-header-text h1 {
      margin: 0;

      font-size: 18px;
      font-weight: 700;
    }

    .pp-header-text h1 .pp-suffix {
      font-weight: 500;
      color: var(--pp-muted);
    }

    .pp-header-text .pp-subline {
      margin-top: 2px;

      font-size: 13px;
      color: var(--pp-muted);
    }


    /* Metadata */

    .pp-meta-row {
      display: grid;

      grid-template-columns: 1fr 1fr 1fr;

      gap: 24px;
      align-items: center;

      padding: 20px 24px;

      border-bottom: 1px solid var(--pp-border);
    }

    .pp-meta-label {
      font-size: 11px;

      letter-spacing: 0.06em;

      text-transform: uppercase;

      color: var(--pp-muted);

      margin-bottom: 4px;
    }

    .pp-meta-value {
      font-size: 15px;
      font-weight: 700;
    }

    .pp-meta-value-small {
      font-size: 13px;
      font-weight: 600;
    }


    /* Sections */

    .pp-grid {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 16px;

      padding: 20px 24px;
    }

    @media (max-width: 900px) {
      .pp-grid {
        grid-template-columns: 1fr;
      }

      .pp-meta-row {
        grid-template-columns: 1fr;
      }
    }

    .pp-section {
      border: 1px solid var(--pp-border);
      border-radius: var(--pp-radius-md);

      padding: 16px;
    }

    .pp-section h2 {
      margin: 0 0 12px;

      font-size: 14px;
      font-weight: 700;
    }


    /* ================================================================
       USER METADATA SECTION
       ================================================================ */

    .pp-user-fields {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 0;

      border: 1px solid var(--pp-border);
      border-radius: var(--pp-radius-md);

      overflow: hidden;
    }

    .pp-user-field {
      padding: 11px 12px;

      border-right: 1px solid var(--pp-border);
      border-bottom: 1px solid var(--pp-border);
    }

    .pp-user-field:nth-child(2n) {
      border-right: none;
    }

    .pp-user-field:nth-last-child(-n + 2) {
      border-bottom: none;
    }

    .pp-user-field-label {
      font-size: 10px;

      text-transform: uppercase;
      letter-spacing: 0.06em;

      color: var(--pp-muted);

      margin-bottom: 3px;
    }

    .pp-user-field-value {
      font-size: 13px;
      font-weight: 600;
    }


    /* ================================================================
       ACTIVITY / EMISSIONS
       ================================================================ */

    .pp-footprint-total {
      display: flex;

      justify-content: space-between;
      align-items: baseline;

      margin-bottom: 12px;
    }

    .pp-footprint-value {
      font-size: 30px;
      font-weight: 800;
    }

    .pp-footprint-unit {
      font-size: 13px;
      color: var(--pp-muted);
      margin-left: 4px;
    }

    .pp-footprint-label {
      font-size: 12.5px;
      color: var(--pp-accent);
      font-weight: 600;
    }

    .pp-fp-segment {
      margin-bottom: 10px;
    }

    .pp-fp-segment-label {
      display: flex;

      justify-content: space-between;

      font-size: 12px;

      color: var(--pp-muted);

      margin-bottom: 3px;
    }

    .pp-fp-track {
      height: 6px;

      background: var(--pp-track);

      border-radius: 4px;

      overflow: hidden;
    }

    .pp-fp-fill {
      height: 100%;

      background: var(--pp-primary);

      border-radius: 4px;
    }


    /* ================================================================
       SUSTAINABILITY
       ================================================================ */

    .pp-score {
      display: flex;

      align-items: center;
      justify-content: space-between;

      margin-bottom: 14px;
    }

    .pp-score-value {
      font-size: 30px;
      font-weight: 800;
    }

    .pp-score-label {
      font-size: 12px;
      color: var(--pp-muted);
    }

    .pp-score-bar {
      height: 8px;

      background: var(--pp-track);

      border-radius: 5px;

      overflow: hidden;
    }

    .pp-score-fill {
      height: 100%;

      background: var(--pp-accent);

      border-radius: 5px;
    }

    .pp-status-line {
      display: flex;

      align-items: center;

      gap: 8px;

      padding: 9px 0;

      border-top: 1px solid var(--pp-border);

      font-size: 12.5px;
    }

    .pp-status-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: var(--pp-accent);

      flex-shrink: 0;
    }


    /* ================================================================
       VERIFICATION
       ================================================================ */

    .pp-verify-row {
      display: flex;

      gap: 12px;

      align-items: flex-start;
    }

    .pp-verify-icon {
      width: 40px;
      height: 40px;

      border-radius: 50%;

      background: rgba(20, 184, 166, 0.12);

      color: var(--pp-accent);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 16px;
      font-weight: 800;

      flex-shrink: 0;
    }

    .pp-verify-title {
      font-size: 13px;
      font-weight: 700;
    }

    .pp-verify-line {
      font-size: 12px;

      color: var(--pp-muted);

      margin-top: 2px;
    }

    .pp-verify-status {
      display: inline-flex;

      align-items: center;

      gap: 4px;

      font-size: 12px;

      color: var(--pp-accent);

      font-weight: 600;

      margin-top: 6px;
    }


    /* ================================================================
       CALCULATION METADATA
       ================================================================ */

    .pp-calculation-list {
      display: flex;
      flex-direction: column;
    }

    .pp-calculation-row {
      display: flex;

      justify-content: space-between;
      align-items: center;

      padding: 8px 0;

      border-top: 1px solid var(--pp-border);

      font-size: 12.5px;
    }

    .pp-calculation-row:first-child {
      border-top: none;
    }

    .pp-calculation-label {
      color: var(--pp-muted);
    }

    .pp-calculation-value {
      font-weight: 600;
      text-align: right;
    }


    /* ================================================================
       QR
       ================================================================ */

    .pp-qr-box {
      display: flex;

      align-items: center;

      gap: 12px;

      border: 1px solid var(--pp-border);

      border-radius: var(--pp-radius-md);

      padding: 10px 16px;

      background: #FAFBFC;
    }

    .pp-qr-icon {
      width: 40px;
      height: 40px;

      border-radius: 6px;

      background: var(--pp-track);

      background-size: cover;
      background-position: center;

      flex-shrink: 0;
    }

    .pp-qr-label {
      font-size: 13px;
      font-weight: 600;
    }

    .pp-qr-sublabel {
      font-size: 12px;
      color: var(--pp-muted);
    }


    /* ================================================================
       MRZ / MACHINE DATA
       ================================================================ */

    .pp-mrz {
      border-top: 1px solid var(--pp-border);

      background: var(--pp-primary);

      color: #fff;

      padding: 16px 24px 18px;
    }

    .pp-mrz-caption {
      font-size: 9.5px;

      text-transform: uppercase;

      letter-spacing: 0.1em;

      color: rgba(255,255,255,0.65);

      margin-bottom: 8px;
    }

    .pp-mrz-line {
      font-family: 'Space Mono', monospace;

      font-size: 10.5px;

      letter-spacing: 0.08em;

      color: rgba(255,255,255,0.8);

      white-space: nowrap;

      overflow-x: auto;

      scrollbar-width: none;
    }

    .pp-mrz-line::-webkit-scrollbar {
      display: none;
    }

    .pp-mrz-line + .pp-mrz-line {
      margin-top: 4px;
    }


    /* ================================================================
       FOOTER
       ================================================================ */

    .pp-footer-note {
      font-size: 12px;

      color: var(--pp-muted);

      padding: 4px 24px 20px;
    }

    .pp-footer-note::before {
      content: "✎ ";
    }


    /* ================================================================
       MOBILE ADJUSTMENTS
       ================================================================ */

    @media (max-width: 639px) {
      body {
        padding: 16px;
      }

      .pp-wrap {
        gap: 16px;
      }
    }


    @media (prefers-reduced-motion: reduce) {
      * {
        transition: none !important;
      }
    }
  </style>
</head>

<body>

  <div class="pp-wrap">


    <!-- ============================================================
         USER PASSPORT — MOBILE DIGITAL BADGE
         ============================================================ -->

    <div class="pp-mobile-badge">

      <div class="pp-badge-card">

        <div class="pp-badge-topbar">
          <span>
            User · Digital Passport
          </span>

          <span>✓</span>
        </div>


        <div class="pp-badge-body">

          <!-- Identity -->
          <div class="pp-badge-id-row">

            <% if (user.photoUrl) { %>

              <div
                class="pp-badge-avatar"
                style="background-image:url('<%= user.photoUrl %>')"
              ></div>

            <% } else { %>

              <div class="pp-badge-avatar-initials">
                <%= (user.displayName || 'U')
                  .split(/\s+/)
                  .map(function(n) { return n.charAt(0); })
                  .slice(0, 2)
                  .join('')
                  .toUpperCase() %>
              </div>

            <% } %>


            <div>

              <div class="pp-badge-name">
                <%= userName %>
              </div>

              <div class="pp-badge-subline">
                <%= userRole %>
              </div>

              <div class="pp-badge-subline">
                <%= userOrg %>
              </div>

              <span class="pp-badge-pill">
                USER PASSPORT
              </span>

            </div>

          </div>


          <!-- Identity fields -->
          <div class="pp-badge-identity">

            <div class="pp-badge-field">
              <div class="pp-badge-field-label">
                Department
              </div>

              <div class="pp-badge-field-value">
                <%= fmtNum(user.department || 'Not disclosed') %>
              </div>
            </div>


            <div class="pp-badge-field">
              <div class="pp-badge-field-label">
                Location
              </div>

              <div class="pp-badge-field-value">
                <%= fmtNum(user.location || 'Not disclosed') %>
              </div>
            </div>


            <div class="pp-badge-field">
              <div class="pp-badge-field-label">
                Reporting year
              </div>

              <div class="pp-badge-field-value">
                <%= fmtNum(emissions.reportingYear) %>
              </div>
            </div>


            <div class="pp-badge-field">
              <div class="pp-badge-field-label">
                Activities
              </div>

              <div class="pp-badge-field-value">
                <%= fmtNum(activityCount) %>
              </div>
            </div>

          </div>


          <!-- Footprint -->
          <div class="pp-badge-section-label">
            My footprint
          </div>

          <div class="pp-badge-footprint">

            <div class="pp-badge-fp-row">

              <div>
                <span class="pp-badge-fp-value">
                  <%= fmtEmission(emissions.total) %>
                </span>

                <span class="pp-badge-fp-unit">
                  tCO2e
                </span>
              </div>

              <div class="pp-badge-fp-offset">
                <%= emissions.reportingYear || 'Current year' %>
              </div>

            </div>


            <div class="pp-badge-fp-track">

              <% activitySegments.forEach(function(seg, i) { %>

                <div
                  class="pp-badge-fp-seg"
                  style="
                    width:<%= seg.percent %>%;
                    background:<%= segmentColors[i % segmentColors.length] %>
                  "
                ></div>

              <% }); %>

            </div>


            <div class="pp-badge-fp-legend">

              <% activitySegments.forEach(function(seg) { %>

                <span>
                  <%= seg.label %>
                </span>

              <% }); %>

            </div>

          </div>


          <!-- Sustainability -->
          <% if (flags.showSustainability) { %>

            <div class="pp-badge-status-row">

              <div class="pp-badge-status-icon">
                ✓
              </div>

              <div>

                <div class="pp-badge-status-title">
                  Sustainability score
                </div>

                <div class="pp-badge-status-sub">
                  <%= sustainabilityScore == null
                    ? 'Not available'
                    : sustainabilityScore %>
                </div>

              </div>

              <div class="pp-badge-info-btn">
                i
              </div>

            </div>

          <% } %>


          <!-- Verification -->
          <% if (flags.showVerification) { %>

            <div class="pp-badge-status-row">

              <div class="pp-badge-status-icon">
                ✓
              </div>

              <div>

                <div class="pp-badge-status-title">
                  Verification
                </div>

                <div class="pp-badge-status-sub">
                  <%= verificationStatus %>
                </div>

              </div>

              <div class="pp-badge-info-btn">
                i
              </div>

            </div>

          <% } %>

        </div>

      </div>

    </div>


    <!-- ============================================================
         USER PASSPORT — DESKTOP
         ============================================================ -->

    <div class="pp-desktop-card">

      <div class="pp-card">


        <!-- Header -->
        <div class="pp-header">

          <% if (user.photoUrl) { %>

            <div
              class="pp-avatar"
              style="background-image:url('<%= user.photoUrl %>')"
            ></div>

          <% } else { %>

            <div class="pp-avatar-initials">
              <%= (user.displayName || 'U')
                .split(/\s+/)
                .map(function(n) { return n.charAt(0); })
                .slice(0, 2)
                .join('')
                .toUpperCase() %>
            </div>

          <% } %>


          <div class="pp-header-text">

            <h1>
              <%= userName %>

              <span class="pp-suffix">
                · User Passport
              </span>
            </h1>

            <div class="pp-subline">

              <%= userRole %>

              ·

              <%= userOrg %>

              <% if (user.idNumber) { %>
                · ID <%= user.idNumber %>
              <% } %>

            </div>

          </div>

        </div>


        <!-- Metadata -->
        <div class="pp-meta-row">

          <div>

            <div class="pp-meta-label">
              Role
            </div>

            <div class="pp-meta-value">
              <%= userRole %>
            </div>

          </div>


          <div>

            <div class="pp-meta-label">
              Organization
            </div>

            <div class="pp-meta-value">
              <%= userOrg %>
            </div>

          </div>


          <div>

            <div class="pp-qr-box">

              <% if (qr.imageUrl) { %>

                <div
                  class="pp-qr-icon"
                  style="background-image:url('<%= qr.imageUrl %>')"
                ></div>

              <% } else { %>

                <div class="pp-qr-icon"></div>

              <% } %>


              <div>

                <div class="pp-qr-label">
                  <%= qr.label || 'User passport verification' %>
                </div>

                <div class="pp-qr-sublabel">
                  <%= qr.sublabel || 'Verify sustainability record' %>
                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- Main grid -->
        <div class="pp-grid">


          <!-- ======================================================
               PROFILE
               ====================================================== -->

          <div class="pp-section">

            <h2>
              Profile
            </h2>

            <div class="pp-user-fields">

              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Department
                </div>

                <div class="pp-user-field-value">
                  <%= fmtNum(user.department || 'Not disclosed') %>
                </div>

              </div>


              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Location
                </div>

                <div class="pp-user-field-value">
                  <%= fmtNum(user.location || 'Not disclosed') %>
                </div>

              </div>


              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Work model
                </div>

                <div class="pp-user-field-value">
                  <%= userWorkModel %>
                </div>

              </div>


              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Reporting year
                </div>

                <div class="pp-user-field-value">
                  <%= fmtNum(emissions.reportingYear) %>
                </div>

              </div>


              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Activities recorded
                </div>

                <div class="pp-user-field-value">
                  <%= fmtNum(activityCount) %>
                </div>

              </div>


              <div class="pp-user-field">

                <div class="pp-user-field-label">
                  Record type
                </div>

                <div class="pp-user-field-value">
                  Digital User Passport
                </div>

              </div>

            </div>

          </div>


          <!-- ======================================================
               FOOTPRINT
               ====================================================== -->

          <% if (flags.showActivityBreakdown) { %>

            <div class="pp-section">

              <h2>
                My event footprint
              </h2>


              <div class="pp-footprint-total">

                <div>

                  <span class="pp-footprint-value">
                    <%= fmtEmission(emissions.total) %>
                  </span>

                  <span class="pp-footprint-unit">
                    tCO2e
                  </span>

                </div>


                <div class="pp-footprint-label">
                  <%= emissions.reportingYear || 'Reporting year' %>
                </div>

              </div>


              <% activitySegments.forEach(function(seg) { %>

                <div class="pp-fp-segment">

                  <div class="pp-fp-segment-label">

                    <span>
                      <%= seg.label %>
                    </span>

                    <span>
                      <%= fmtEmission(seg.value) %>
                    </span>

                  </div>


                  <div class="pp-fp-track">

                    <div
                      class="pp-fp-fill"
                      style="width:<%= seg.percent %>%"
                    ></div>

                  </div>

                </div>

              <% }); %>

            </div>

          <% } %>


          <!-- ======================================================
               SUSTAINABILITY
               ====================================================== -->

          <% if (flags.showSustainability) { %>

            <div class="pp-section">

              <h2>
                Sustainability
              </h2>


              <div class="pp-score">

                <div>

                  <div class="pp-meta-label">
                    Sustainability score
                  </div>

                  <div class="pp-score-value">
                    <%= sustainabilityScore == null
                      ? '—'
                      : sustainabilityScore %>
                  </div>

                </div>


                <div class="pp-score-label">
                  Overall
                </div>

              </div>


              <%
                let scorePercent = 0;

                if (
                  sustainabilityScore !== null &&
                  sustainabilityScore !== undefined &&
                  sustainabilityScore !== '' &&
                  !Number.isNaN(Number(sustainabilityScore))
                ) {
                  scorePercent = Math.max(
                    0,
                    Math.min(100, Number(sustainabilityScore))
                  );
                }
              %>


              <div class="pp-score-bar">

                <div
                  class="pp-score-fill"
                  style="width:<%= scorePercent %>%"
                ></div>

              </div>


              <div class="pp-status-line">

                <span class="pp-status-dot"></span>

                <span>
                  <%= verificationStatus %>
                </span>

              </div>


              <div class="pp-status-line">

                <span class="pp-status-dot"></span>

                <span>
                  <%= activityCount %> activities recorded
                </span>

              </div>

            </div>

          <% } %>


          <!-- ======================================================
               VERIFICATION
               ====================================================== -->

          <% if (flags.showVerification) { %>

            <div class="pp-section">

              <h2>
                Verification & sharing
              </h2>


              <div class="pp-verify-row">

                <div class="pp-verify-icon">
                  ✓
                </div>


                <div>

                  <div class="pp-verify-title">
                    Sustainability Passport Record
                  </div>


                  <div class="pp-verify-line">

                    Status:
                    <%= verificationStatus %>

                  </div>


                  <div class="pp-verify-line">

                    Reporting year:
                    <%= fmtNum(emissions.reportingYear) %>

                  </div>


                  <div class="pp-verify-status">

                    ● <%= verificationStatus %>

                  </div>

                </div>

              </div>

            </div>

          <% } %>


          <!-- ======================================================
               CALCULATION / RECORD INFORMATION
               ====================================================== -->

          <% if (flags.showMetadata) { %>

            <div class="pp-section">

              <h2>
                Record information
              </h2>


              <div class="pp-calculation-list">

                <div class="pp-calculation-row">

                  <span class="pp-calculation-label">
                    Reporting year
                  </span>

                  <span class="pp-calculation-value">
                    <%= fmtNum(emissions.reportingYear) %>
                  </span>

                </div>


                <div class="pp-calculation-row">

                  <span class="pp-calculation-label">
                    Activities recorded
                  </span>

                  <span class="pp-calculation-value">
                    <%= fmtNum(activityCount) %>
                  </span>

                </div>


                <div class="pp-calculation-row">

                  <span class="pp-calculation-label">
                    Last calculated
                  </span>

                  <span class="pp-calculation-value">
                    <%= fmtNum(lastCalculationDate) %>
                  </span>

                </div>


                <div class="pp-calculation-row">

                  <span class="pp-calculation-label">
                    Verification
                  </span>

                  <span class="pp-calculation-value">
                    <%= verificationStatus %>
                  </span>

                </div>

              </div>

            </div>

          <% } %>


        </div>


        <!-- Machine readable zone -->
        <!-- <div class="pp-mrz">

          <div class="pp-mrz-caption">
            Machine Readable Zone
          </div>


          <div class="pp-mrz-line">
            DP&lt;USR&lt;&lt;<%= mrzName %>&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;
          </div>


          <div class="pp-mrz-line">
            <%= mrzOrg %><%= mrzYear %>IND&lt;&lt;T&lt;<%= mrzTotal %>&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;1
          </div>

        </div> -->


        <!-- <div class="pp-footer-note">
          This passport contains anonymized, aggregated personal sustainability data.
        </div> -->

      </div>

    </div>


  </div>

</body>
</html>